import org.apache.spark.sql.types.{StringType, DoubleType,IntegerType, StructType,LongType}
import spark.implicits._

spark.conf.set("spark.cassandra.connection.host","cas1.mipemnet.com")

val pfsenseSchema = new StructType()
 .add("message",StringType)

val kafkaDF = spark.readStream.format("kafka").option("kafka.bootstrap.servers","kfk1.mipemnet.com:9092").option("subscribe","pfsense").option("startingOffsets","latest").load()
val parsedDF = kafkaDF.selectExpr("CAST(value AS STRING)")
 .select(from_json(col("value"),pfsenseSchema).alias("dat"))
 .select(col("dat.message") as ("message"))

val splitDF=parsedDF.withColumn("src",split($"message",",").getItem(18)).withColumn("dst",split($"message",",").getItem(19))
val out=splitDF.writeStream.format("console").option("truncate","false").start()

splitDF.writeStream.format("org.apache.spark.sql.cassandra").option("checkpointLocation","/tmp/checkpointpfsense").option("table","pfsense").option("keyspace","pfsensedata").outputMode("append").start().awaitTermination()
